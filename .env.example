# Credenciais do Postgres (usadas pelo docker-compose)
POSTGRES_USER=cakeapi
POSTGRES_PASSWORD=cakeapi
POSTGRES_DB=cakeapi
POSTGRES_PORT=5433

# Porta exposta pela API no host
API_PORT=8000

# URL usada quando a API roda fora do compose (ex.: uvicorn local).
# Dentro do compose, o DATABASE_URL é montado automaticamente apontando para o serviço "db".
DATABASE_URL=postgresql+psycopg://cakeapi:cakeapi@localhost:5433/cakeapi

SECRET_KEY=change-me-in-production-use-a-long-random-string-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens permitidas para chamadas do navegador (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
